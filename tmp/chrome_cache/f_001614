            function checkToastVisibility() {
                const remainingToasts = document.querySelectorAll('.custom-toast');
                const toastContainer = document.querySelector('.custom-toast-container');
                const closeBar = document.querySelector('.toast-close-all-bar');

                if (remainingToasts.length === 0) {
                    if (toastContainer) toastContainer.style.display = 'none';
                    if (closeBar) closeBar.style.display = 'none';
                }
            }
        </script>
</body>


