            // Function to display toasts one by one
            function showToastsSequentially() {
                const toasts = document.querySelectorAll('.custom-toast');
                let delay = 0;

                toasts.forEach((toast, index) => {
                    setTimeout(() => {
                        toast.style.animation = 'fadeIn 0.5s';
                        toast.style.opacity = 1; // Ensure the toast is visible

                        // Automatically remove toast after its duration
                        setTimeout(() => {
                            removeToastSequentially(toast);
                        }, 4000); // Duration for each toast before removal
                    }, delay);

                    delay += 5000; // Delay between displaying each toast
                });
            }
            document.addEventListener("click", function (e) {
                if (e.target.classList.contains("custom-toast-close")) {
                    const toast = e.target.closest('.custom-toast');
                    removeToastSequentially(toast);
                }
            });
            // Trigger the function after the DOM is loaded
            document.addEventListener("DOMContentLoaded", function () {
                showToastsSequentially();
