                },
                success: function (data) {
                    $("#loaderChart").hide();
                    $("#showdetail").css({
                        opacity: 1
                    });
                    $("#showdetail").html(data);
                }
            });
        } else {
            $("#showdetail").html('');
            $("#loaderChart").hide();
        }
    }

