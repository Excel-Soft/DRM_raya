    $(document).on("change", ".sub-service-checkbox", function () {
        const serviceId = $(this).data("service-id");
        const serviceIndex = $(this).data("service-index");

        const $rowFields = $(
            `select[name='purpose_${serviceId}_${serviceIndex}'],
            select[name='grade_${serviceId}_${serviceIndex}'],
            select[name='method_${serviceId}_${serviceIndex}'],
            select[name='comment_${serviceId}_${serviceIndex}'],
            input[name='next_date_${serviceId}_${serviceIndex}'],
            input[name='note_${serviceId}_${serviceIndex}'],
            input[name='talk_time_${serviceId}_${serviceIndex}'],
            input[name='meeting_proof_${serviceId}_${serviceIndex}[]']`
        );

        if ($(this).is(":checked")) {
            $rowFields.prop("disabled", false);
        } else {
            $rowFields.prop("disabled", true).val("").removeClass("is-invalid");
            $rowFields.filter("input[type='file']").val("");
        }
    });

    // page load pe auto apply
    $(".sub-service-checkbox").trigger("change");

    $(document).ready(function () {
        $("#form_follow").on("submit", function (e) {
            e.preventDefault();

            $("input, select, textarea").removeClass("is-invalid");

            let valid = true;
            let message = "";

            if ($(".main-service-checkbox:checked").length === 0) {
                valid = false;
                message = "Please select at least one main service.";
            }
            else if ($(".sub-service-checkbox:checked").length === 0) {
                valid = false;
                message = "Please select at least one sub-service.";
            }
            else {
                $(".sub-service-checkbox:checked").each(function () {
                    const serviceId = $(this).data("service-id");
                    const serviceIndex = $(this).data("service-index");

                    if (!$(`select[name='purpose_${serviceId}_${serviceIndex}']`).val()) {
                        valid = false;
                        message = "Please select Purpose for all selected sub-services.";
                        $(`select[name='purpose_${serviceId}_${serviceIndex}']`).addClass("is-invalid");
                        return false;
                    }

                    if (!$(`select[name='grade_${serviceId}_${serviceIndex}']`).val()) {
                        valid = false;
                        message = "Please select Grade for all selected sub-services.";
                        $(`select[name='grade_${serviceId}_${serviceIndex}']`).addClass("is-invalid");
                        return false;
                    }

