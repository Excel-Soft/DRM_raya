                var renwal = 'Rc';
                RC++;
                var color = 'bg-info';
            } else if (data[i].renwal == 2) {
                var renwal = 'Ec';
                EC++;
                var color = 'bg-danger';
            } else if (data[i].renwal == 3) {
                var renwal = 'Rc-Up'
                var color = 'bg-warning';
            } else {
                var renwal = 'None';
            }

            if (data[i].droupout == 1) {
