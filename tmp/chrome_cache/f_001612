<script>

    $(document).on('click', '.js-update-followup', function () {
        const comId = $(this).data('com-id');
        const followupId = $(this).data('followup-id');

        $('#modal_com_id').val(comId);
        $('#modal_follow_up_id').val(followupId);
        $('#services_container').html('<div class="text-center py-3">Loading...</div>');

        $.ajax({
            url: 'layouts/Controller/FollowupController.php',
            type: 'POST',
            dataType: 'json',
            data: {
                action: 'getCompanyFollowups',
                com_id: comId
            },
            success: function (res) {
                if (!res.success || !res.data) {
                    alert(res.message || 'No data found');
                    return;
                }

                const f = res.data.followup;
                const services = res.data.services || [];

                $('#modal_company_name').val(f.company_name || '');
                $('#modal_followup_note').val(f.followup_note || '');
                $('#modal_follow_up_id').val(f.follow_up_id || '');

                let html = '';

                if (services.length > 0) {
                    services.forEach(function (item, index) {
                        html += `
                        <div class="card mb-3">
                            <div class="card-header">
                                <strong>Service #${index + 1}</strong>
                            </div>
                            <div class="card-body">
                                <input type="hidden" name="services[${index}][id]" value="${item.id || ''}">
                                <input type="hidden" name="services[${index}][service_id]" value="${item.service_id || ''}">

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Service Type</label>
                                        <input type="text" name="services[${index}][service_type]" class="form-control" value="${item.service_type || ''}">
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Grade</label>
                                        <input type="text" name="services[${index}][grade]" class="form-control" value="${item.grade || ''}">
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Method</label>
                                        <input type="text" name="services[${index}][method]" class="form-control" value="${item.method || ''}">
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Purpose</label>
                                        <input type="text" name="services[${index}][purpose]" class="form-control" value="${item.purpose || ''}">
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Next Date</label>
                                        <input type="date" name="services[${index}][next_date]" class="form-control" value="${item.next_date || ''}">
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Comment</label>
                                        <input type="text" name="services[${index}][comment]" class="form-control" value="${item.comment || ''}">
                                    </div>

                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">Note</label>
                                        <textarea name="services[${index}][note]" class="form-control">${item.note || ''}</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    });
                } else {
                    html = `<div class="alert alert-warning">No service record found.</div>`;
                }

                $('#services_container').html(html);
                $('#updateFollowupModal').modal('show');
            },
            error: function () {
                alert('Ajax error while loading followup data');
            }
        });
    });
</script>

