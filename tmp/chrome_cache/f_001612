<script>
    $(document).ready(function () {

        // ✅ Backend (attribute) -> Frontend main service ID mapping
        const MAIN_SERVICE_MAP = {
            316: 1, // Alibaba Membership
            317: 2, // Alibaba Services
            318: 3, // Design Development
            319: 4  // Domain Hosting
        };

        function resetFollowupModal() {
            $("#form_follow")[0].reset();
            $(".main-service-checkbox").prop("checked", false);
            $("#allSubServicesContainer").html("");

            $("#additionalDetailsSection").hide();
            $("#toggleAdditionalDetails")
                .removeClass("btn-outline-danger")
                .addClass("btn-outline-primary")
                .html('<i class="fas fa-plus-circle"></i> Show Additional Details');

            $("#talk_mint_reservation").hide();
            $("#talk_mint_res").val("");
        }

        // format DB datetime -> input[type=datetime-local]
        function toDatetimeLocal(val) {
            if (!val) return "";
            return String(val).replace(" ", "T").substring(0, 16);
        }

        function applyPrefill(services) {
            if (!Array.isArray(services) || services.length === 0) return;

            const MAIN_SERVICE_MAP = { 316: 1, 317: 2, 318: 3, 319: 4 };

            // group by UI main-service id (1..4)
            const group = {};
            services.forEach(svc => {
                const backendId = parseInt(svc.service_id, 10);
                const uiMainId = MAIN_SERVICE_MAP[backendId];
                if (!uiMainId) return;
                if (!group[uiMainId]) group[uiMainId] = [];
                group[uiMainId].push(svc);
            });

            // ✅ Prevent duplicate headers/containers by removing old containers first
            Object.keys(group).forEach(uiMainId => {
                $(`#service_container_${uiMainId}`).remove();
            });

            // 1) Render required main services (ONLY ONCE)
            Object.keys(group).forEach(uiMainId => {
                const $main = $("#service_" + uiMainId);
                if (!$main.length) return;

                // check but DON'T trigger change multiple times
                if (!$main.is(":checked")) {
                    $main.prop("checked", true);
                }

                // ✅ fire only native change so renderSubServices runs exactly once
                $main[0].dispatchEvent(new Event("change", { bubbles: true }));
            });

            // 2) Wait until containers are created
            const waitForContainers = setInterval(function () {
                let allReady = true;
                Object.keys(group).forEach(uiMainId => {
                    if (!$(`#service_container_${uiMainId}`).length) allReady = false;
                });

                if (!allReady) return;

                clearInterval(waitForContainers);

                // 3) Fill sub services
                Object.keys(group).forEach(uiMainId => {
                    group[uiMainId].forEach(svc => {

                        const subName = (svc.service_type || "").trim();
                        if (!subName) return;

                        const $cb = $(`#service_container_${uiMainId} .sub-service-checkbox`).filter(function () {
                            return norm($(this).val()) === norm(subName);
                        });

                        if (!$cb.length) {
                            console.warn("Sub-service not found:", subName, "uiMainId:", uiMainId);
                            return;
                        }

                        const serviceIndex = $cb.data("service-index");

                        // check
                        $cb.prop("checked", true);

                        // ✅ Directly show + enable row fields (reliable)
                        showRowFields(uiMainId, serviceIndex);
                        enableRowFields(uiMainId, serviceIndex);

                        // fill values
                        $(`select[name='purpose_${uiMainId}_${serviceIndex}']`).val(svc.purpose || "");
                        $(`select[name='grade_${uiMainId}_${serviceIndex}']`).val(svc.grade || "");
                        $(`select[name='method_${uiMainId}_${serviceIndex}']`).val(svc.method || "").trigger("change");
                        $(`select[name='comment_${uiMainId}_${serviceIndex}']`).val(svc.comment || "");
                        $(`input[name='next_date_${uiMainId}_${serviceIndex}']`).val(toDatetimeLocal(svc.next_date || ""));
                        $(`input[name='note_${uiMainId}_${serviceIndex}']`).val(svc.note || "");

                        if (svc.talk_time) {
                            $(`input[name='talk_time_${uiMainId}_${serviceIndex}']`).val(svc.talk_time);
                            // show talk time row if needed
                            $(`#talk_time_${uiMainId}_${serviceIndex}`).show();
                        }

                    });
                });

            }, 80);
        }

        // ✅ Modal open
        $("#staticBackdrop").on("show.bs.modal", function (event) {
            resetFollowupModal();

            const button = $(event.relatedTarget);
            const comId = button.data("com-id");
            const cname = button.data("cname");

            $("#comnNameData").val(cname);

            // ✅ IMPORTANT: hidden comname should store comId not cname
            $("#comname").val(comId);

            $.ajax({
                url: "layouts/Controller/FollowupController.php",
                type: "POST",
                dataType: "json",
                data: { action: "getCompanyFollowups", com_id: comId },
                success: function (resp) {
                    if (!resp || !resp.success) {
                        console.log(resp?.message || "No response");
                        return;
                    }

                    if (resp.data && resp.data.services) {
                        // ✅ Prefill
                        applyPrefill(resp.data.services);
                    }

                    // Additional details (optional if backend returns)
                    if (resp.data && resp.data.followup) {
                        if (resp.data.followup.reservation) {
                            $("#additionalDetailsSection").show();
                            $("#toggleAdditionalDetails")
                                .removeClass("btn-outline-primary")
                                .addClass("btn-outline-danger")
                                .html('<i class="fas fa-minus-circle"></i> Hide Additional Details');

                            $("#reservation").val(resp.data.followup.reservation).trigger("change");
                        }
                        if (resp.data.followup.talk_mint_res) {
                            $("#talk_mint_res").val(resp.data.followup.talk_mint_res);
                        }
                    }
                },
                error: function (xhr) {
                    console.log("AJAX error:", xhr.status, xhr.responseText);
                }
            });
        });

        $("#staticBackdrop").on("hidden.bs.modal", function () {
            resetFollowupModal();
        });

    });
    function norm(v) { return (v || "").toString().trim().toLowerCase(); }

    function showRowFields(uiMainId, serviceIndex) {
        // show columns
        $(`#purpose_col_${uiMainId}_${serviceIndex}`).show();
        $(`#grade_col_${uiMainId}_${serviceIndex}`).show();
        $(`#method_col_${uiMainId}_${serviceIndex}`).show();
        $(`#comment_col_${uiMainId}_${serviceIndex}`).show();
        $(`#nextdate_col_${uiMainId}_${serviceIndex}`).show();
        $(`#note_col_${uiMainId}_${serviceIndex}`).show();
        $(`#meeting_col_${uiMainId}_${serviceIndex}`).show();
    }

    function enableRowFields(uiMainId, serviceIndex) {
        $(
            `select[name='purpose_${uiMainId}_${serviceIndex}'],
     select[name='grade_${uiMainId}_${serviceIndex}'],
     select[name='method_${uiMainId}_${serviceIndex}'],
     select[name='comment_${uiMainId}_${serviceIndex}'],
     input[name='next_date_${uiMainId}_${serviceIndex}'],
     input[name='note_${uiMainId}_${serviceIndex}'],
     input[name='talk_time_${uiMainId}_${serviceIndex}'],
     input[name='meeting_proof_${uiMainId}_${serviceIndex}[]']`
        ).prop("disabled", false);
    }

</script>
