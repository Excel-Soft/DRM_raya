            <i class="fas fa-minus toggle-icon"></i>
        `;

            const contentDiv = document.createElement('div');
            contentDiv.className = 'service-content-collapse p-1';
            contentDiv.style.display = 'block';

            headerDiv.addEventListener('click', function () {
                const isActive = this.classList.contains('active');

                if (!isActive) {
                    collapseAllServices();
                    this.classList.add('active');
                    contentDiv.style.display = 'block';
                    const icon = this.querySelector('.toggle-icon');
                    icon.classList.remove('fa-plus');
                    icon.classList.add('fa-minus');
                } else {
                    this.classList.remove('active');
                    contentDiv.style.display = 'none';
                    const icon = this.querySelector('.toggle-icon');
                    icon.classList.remove('fa-minus');
                    icon.classList.add('fa-plus');
                }
            });

            const subServicesColumn = document.createElement('div');
            subServicesColumn.className = 'row g-2';

            const initialDisplayCount = 5;
            const shouldShowLoadMore = services.length > initialDisplayCount;

            services.forEach((service, index) => {
                const subServiceRow = createSubServiceRow(serviceId, service, index);

                if (shouldShowLoadMore && index >= initialDisplayCount) {
                    subServiceRow.style.display = 'none';
                    subServiceRow.classList.add('hidden-service');
                }

                subServicesColumn.appendChild(subServiceRow);
            });

            // Add Load More button if needed
