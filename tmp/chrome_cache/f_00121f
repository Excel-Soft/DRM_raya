// print order function
function printOrder(orderId = null) {
	if(orderId) {

		$.ajax({
			url: 'layouts/printOrder.php',
			type: 'post',
			data: {orderId: orderId},
			dataType: 'text',
			success:function(response) {

				var mywindow = window.open('', 'Stock Management System', 'height=400,width=600');
        mywindow.document.write('<html><head><title>Order Invoice</title>');
        mywindow.document.write('</head><body>');
        mywindow.document.write(response);
        mywindow.document.write('</body></html>');

        mywindow.document.close(); // necessary for IE >= 10
        mywindow.focus(); // necessary for IE >= 10
        mywindow.resizeTo(screen.width, screen.height);
setTimeout(function() {
    mywindow.print();
    mywindow.close();
}, 1250);

        //mywindow.print();
        //mywindow.close();

			}// /success function
		}); // /ajax function to fetch the printable order
	} // /if orderId
} // /print order function

function addRow() {

	var tableLength = $("#productTable tbody tr").length;

	var tableRow;
	var arrayNumber;
	var count;

	if(tableLength > 0) {
		tableRow = $("#productTable tbody tr:last").attr('id');
		arrayNumber = $("#productTable tbody tr:last").attr('class');
		count = tableRow.substring(3);
		count = Number(count) + 1;
		arrayNumber = Number(arrayNumber) + 1;
	} else {
		// no table row
		count = 1;
		arrayNumber = 0;
	}

	$.ajax({
		url: 'layouts/fetchProductData.php',
		type: 'post',
		dataType: 'json',
		success:function(response) {
			$("#addRowBtn").button("reset");

			var tr = '<tr id="row'+count+'" class="'+arrayNumber+'">'+
				'<td>'+
					'<div class="col-md-3 form-group">'+
					'<select class="form-control select2" name="productName[]" id="productName'+count+'" onchange="getProductData('+count+')"  style="width:235px !important;">'+
						'<option value="" selected>Select</option>';
						$.each(response, function(index, value) {
							tr += '<option value="'+value[0]+'">'+value[2]+'</option>';
						});
					tr += '</select>'+
					'</div>'+
				'</td>'+
                '<td>'+
					'<div class="col-md-3 form-group">'+
						' <textarea cols="1" rows="1" name="detail[]" id="detail'+count+'" class="form-control"  style="width:315px !important;"></textarea>'+
					'</div>'+
				'</td>'+
                '<td>'+
					'<div class="col-md-1 form-group  w-100">'+
						'<input type="text" name="min[]" id="min'+count+'"  onkeyup="getTotal('+count+')" class="inner form-control" />'+
					'</div>'+
				'</td>'+
				'<td>'+
					'<div class="col-md-1 form-group  w-100">'+
						'<input type="text" name="max[]" id="max'+count+'"  onkeyup="getTotal('+count+')" class="inner form-control" />'+
						'<input type="hidden" name="minValue[]" id="minValue'+count+'" autocomplete="off" class="form-control" />'+
						'<input type="hidden" name="maxValue[]" id="maxValue'+count+'" autocomplete="off" class="form-control" />'+
					'</div>'+
				'</td>'+
				'<td>'+
					'<div class="col-md-1 form-group  w-100">'+
						'<input type="text" name="rate[]" id="rate'+count+'"  onkeyup="getTotal('+count+')"  class="inner form-control" />'+
						'<input type="hidden" name="rateValue[]" id="rateValue'+count+'" autocomplete="off" class="form-control" />'+
					'</div>'+
				'</td>'+
				'<td>'+
					'<div class="col-md-1 form-group  w-100">'+
						'<input type="number" name="quantity[]" id="quantity'+count+'" onkeyup="getTotal('+count+')" autocomplete="off" class="inner form-control" min="1" />'+
					'</div>'+
				'</td>'+
				'<td>'+
					'<div class="col-md-1 form-group  w-100">'+
						'<input type="text" name="total[]" id="total'+count+'" autocomplete="off"  class="inner form-control" disabled="true" />'+
						'<input type="hidden" name="totalValue[]" id="totalValue'+count+'" autocomplete="off" class="form-control" />'+
					'</div>'+
				'</td>'+

				// Start Year
				'<td>'+
					'<div class="col-md-2">'+
						'<select name="from_year[]" id="from_year'+count+'" class="form-control">';
							for (var y = 2000; y <= new Date().getFullYear(); y++) {
								tr += '<option value="'+y+'">'+y+'</option>';
							}
						tr += '</select>'+
					'</div>'+
				'</td>'+

				// End Year
				'<td>'+
					'<div class="col-md-2">'+
						'<select name="to_year[]" id="to_year'+count+'" class="form-control">';
							for (var y = 2000; y <= new Date().getFullYear() + 5; y++) {
								tr += '<option value="'+y+'">'+y+'</option>';
							}
						tr += '</select>'+
					'</div>'+
				'</td>'+

				// Domain
				'<td>'+
					'<div class="col-md-4">'+
						'<input type="text" name="domain[]" id="domain'+count+'" class="form-control" placeholder="Enter domain" />'+
					'</div>'+
				'</td>'+

				'<td>'+
					'<div class="col-md-1 form-group w-100">'+
						'<div class="mt-2 mt-md-0 d-grid">'+
							'<input type="button" class="btn btn-primary removeProductRowBtn" id="removeProductRowBtn" onclick="removeProductRow('+count+')" value="Delete">'+
						'</div>'+
					'</div>'+
				'</td>'+
			'</tr>';
			
			if(tableLength > 0) {
				$("#productTable tbody tr:last").after(tr);
			} else {
				$("#productTable tbody ").append(tr);
			}

		},
        error: function(xhr, status, error) {
            console.error('AJAX Error:', status, error);
        }
	});	

