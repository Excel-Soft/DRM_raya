        $(document).ready(function () {
            $("#form_follow").on("submit", function (e) {
                e.preventDefault();

                $("input, select, textarea").removeClass("is-invalid");

                let valid = true;
                let message = "";

                if ($(".main-service-checkbox:checked").length === 0) {
                    valid = false;
                    message = "Please select at least one main service.";
                }
                else if ($(".sub-service-checkbox:checked").length === 0) {
                    valid = false;
                    message = "Please select at least one sub-service.";
                }
                else {
                    $(".sub-service-checkbox:checked").each(function () {
                        const serviceId = $(this).data("service-id");
                        const serviceIndex = $(this).data("service-index");

                        if (!$(`select[name='purpose_${serviceId}_${serviceIndex}']`).val()) {
                            valid = false;
                            message = "Please select Purpose for all selected sub-services.";
                            $(`select[name='purpose_${serviceId}_${serviceIndex}']`).addClass("is-invalid");
                            return false;
                        }

                        if (!$(`select[name='grade_${serviceId}_${serviceIndex}']`).val()) {
                            valid = false;
                            message = "Please select Grade for all selected sub-services.";
                            $(`select[name='grade_${serviceId}_${serviceIndex}']`).addClass("is-invalid");
                            return false;
                        }

                        if (!$(`select[name='method_${serviceId}_${serviceIndex}']`).val()) {
                            valid = false;
                            message = "Please select Method for all selected sub-services.";
                            $(`select[name='method_${serviceId}_${serviceIndex}']`).addClass("is-invalid");
                            return false;
                        }

                        if (!$(`select[name='comment_${serviceId}_${serviceIndex}']`).val()) {
                            valid = false;
                            message = "Please select Comment for all selected sub-services.";
                            $(`select[name='comment_${serviceId}_${serviceIndex}']`).addClass("is-invalid");
                            return false;
                        }

                        if (!$(`input[name='next_date_${serviceId}_${serviceIndex}']`).val()) {
                            valid = false;
                            message = "Please enter Next Date for all selected sub-services.";
                            $(`input[name='next_date_${serviceId}_${serviceIndex}']`).addClass("is-invalid");
                            return false;
                        }

                        if (!$(`input[name='note_${serviceId}_${serviceIndex}']`).val().trim()) {
                            valid = false;
                            message = "Please enter Note for all selected sub-services.";
                            $(`input[name='note_${serviceId}_${serviceIndex}']`).addClass("is-invalid");
                            return false;
                        }
                    });
                }

                if ($("#additionalDetailsSection").is(":visible")) {
                    if (!$("#reservation").val()) {
                        valid = false;
                        message = "Please select a Reservation.";
                        $("#reservation").addClass("is-invalid");
                    }
                }

                if (!valid) {
                    alert(message);
                    return false;
                }

                var formData = new FormData(this);
                const noti_text = "Your Request is done!";

                $.ajax({
                    type: 'POST',
                    url: 'layouts/func.php',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        notification_Success(noti_text);
                        $("#form_follow")[0].reset();
                        $("#showdetail").load(" #showdetail");
                        $(".btn-close").click();
                    },
                    error: function () {
                        alert("Something went wrong while submitting the form!");
                    }
                });
            });
        });

