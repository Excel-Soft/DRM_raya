        function displayPagination(totalPages, currentPage) {
            $('#pageNumbers').empty();

            var startPage = Math.max(currentPage - 2, 1);
            var endPage = Math.min(currentPage + 1, totalPages);

            if (startPage > 1) {

                $('#pageNumbers').append('<li class="page-item"><a href="#" class="page-link" data-page="1">1</a></li>');
                if (startPage > 3) {
                    $('#pageNumbers').append('<span class="ellipsis">...</span>');
                }
            }

            for (var i = startPage; i <= endPage; i++) {
                var activeClass = (i === currentPage) ? 'active' : '';
                $('#pageNumbers').append('<li class="page-item ' + activeClass + '"><a href="#" class="page-link ' + activeClass + '" data-page="' + i + '">' + i + '</a></li>');
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    $('#pageNumbers').append('<span class="ellipsis">...</span>');
                }
                $('#pageNumbers').append('<li class="page-item"><a href="#" class="page-link"  data-page="' + totalPages + '">' + totalPages + '</a></li>');
            }
            $('#pageNumbers').append('<li class="page-item" style="width: 70px;"><input type="number" class="form-control form-control-sm" style="width: 70px;" id="manualPageInput" placeholder="Page"></li>');
            $('#pageNumbers').append('<li class="page-item"><button class="btn btn-primary btn-sm" onclick="goToPageBtn()">Go</button></li>');
            $('#pageNumbers').data('total-pages', totalPages);
        }

