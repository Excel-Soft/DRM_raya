        function loadPage(page) {
            $("#loaderCustomer").show();
            $("#showdata").css({
                opacity: 0.5
            })
            $.ajax({
                url: 'layouts/pagenation.php',
                type: 'GET',
                data: {
                    page: page
                },
                contentType: "application/json",
                dataType: 'json',
                success: function (data) {
                    $("#loaderCustomer").hide();
                    $("#showdata").css({
                        opacity: 1
                    });
                    displayData(data);
                    displayPagination(data.totalPages, page);
                },
                error: function (xhr, status, error) {
                    console.error('AJAX Error:', status, error);
                    var nextPage = page + 1;
                    loadPage(nextPage);
                }
            });
        }

