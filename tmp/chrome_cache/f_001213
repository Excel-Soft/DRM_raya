                $(container).css({
                    opacity: 0.5
                });
                try {
                    const response = await fetch(url);
                    if (response.ok) {
                        const html = await response.text();
                        container.innerHTML = html;
                        $(container).css({
                            opacity: 1
                        });
                    } else {
                        container.innerHTML = `<p>Error loading section: ${response.status}</p>`;
