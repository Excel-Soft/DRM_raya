    @keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.1);
        }

        100% {
            transform: scale(1);
        }
    }

    .notification-item {
        transition: all 0.2s ease;
        border-radius: 0;
    }

    .notification-item:hover {
        background-color: #f8f9fa !important;
        transform: translateX(2px);
    }

    .hover-bg-light:hover {
        background-color: #f8f9fa !important;
    }

    .notification-item:not(:last-child) {
        border-bottom: 1px solid #f0f0f0 !important;
    }

    .avatar-title {
        display: flex;
        align-items: center;
