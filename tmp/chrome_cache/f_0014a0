<script>
    document.addEventListener("DOMContentLoaded", function () {
        const badge = document.getElementById("newFeatureBadge");

        if (localStorage.getItem("newFeatureSeen")) {
            badge.style.display = "none"; // Hide if already seen
        } else {
            // First time user sees the badge
            badge.style.display = "inline-block";

            // Set it so it doesn't show again
            localStorage.setItem("newFeatureSeen", "true");
        }
    });
    document.addEventListener("DOMContentLoaded", function () {
        const modal = document.getElementById("quarterlyModal");
        modal.addEventListener("show.bs.modal", function (event) {
            const button = event.relatedTarget;
            const leaveData = JSON.parse(button.getAttribute("data-leave"));
            const submitBtn = document.getElementById("submitLeaveBtn"); // ✅ FIX
            currentUserId = leaveData.user_id;

            document.getElementById("leaveBreakdown").innerHTML = "";


            if (!leaveData.eligible) {
                document.getElementById("leaveBreakdown").innerHTML = `<p class="text-danger">User is not eligible for quarterly leave.</p>`;
                return;
            }

            fetch(`fetch_last4_leaves.php?user_id=${leaveData.user_id}`)
                .then(res => res.json())
                .then(data => {
                    if (data && Array.isArray(data.months)) {
                        let html = `<strong>Last 4 Months Leave Summary:</strong><ul>`;
                        data.months.forEach(month => {
                            html += `<li><strong>${month.label}</strong>: ${month.leaves} leave(s)</li>`;
                        });
                        html += `</ul>`;

                        if (data.eligible_to_request > 0) {
                            html += `<p class="text-success"><strong>Eligible to request:</strong> ${data.eligible_to_request} leave(s)</p>`;
                            submitBtn.disabled = false;
                            submitBtn.dataset.eligible = data.eligible_to_request;
                        } else {
                            html += `<p class="text-warning"><strong>Note:</strong> You have taken leaves in the past 4 months, so you're not eligible for quarterly leaves.</p>`;
                            submitBtn.disabled = true;
                            submitBtn.dataset.eligible = 0;
                        }

                        document.getElementById("leaveBreakdown").innerHTML = html;
                    } else {
                        document.getElementById("leaveBreakdown").innerHTML = `<p class="text-warning">No leave data found.</p>`;
                    }
                }).catch(err => {
                    console.error(err);
                    document.getElementById("leaveBreakdown").innerHTML = `<p class="text-danger">Failed to load leave data.</p>`;
                });
        });
    });
</script>
<script>
    document.getElementById("submitLeaveBtn").addEventListener("click", function () {
        const eligibleLeaves = parseInt(this.dataset.eligible) || 0;
        const leaveReasonInput = document.getElementById("leaveReason");
        const leaveReason = leaveReasonInput?.value.trim();

        // Validate: Leave Reason is required
        if (!leaveReason) {
            Swal.fire({
                icon: 'warning',
                title: 'Missing Reason',
                text: 'Please enter a reason for leave.',
            });
            return;
        }

        // Validate: Reason must be at least 5 characters long
        if (leaveReason.length < 5) {
            Swal.fire({
                icon: 'warning',
                title: 'Too Short',
                text: 'Reason must be at least 5 characters long.',
            });
            return;
        }

        // Validate: Eligible leaves must be > 0
        if (eligibleLeaves <= 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Not Eligible',
                text: 'You are not eligible to apply for quarterly leave.',
            });
            return;
        }

        // Confirm submission before sending
        Swal.fire({
            title: 'Are you sure?',
            text: `You're about to request ${eligibleLeaves} leave(s).`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Submit',
            cancelButtonText: 'Cancel'
        }).then((result) => {
            if (result.isConfirmed) {
                // Proceed with submission
                fetch("layouts/func.php", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: new URLSearchParams({
                        action: "submit_balance_leave",
                        user_id: currentUserId,
                        available_leaves: eligibleLeaves,
                        leave_reason: leaveReason
                    })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.status === "success") {
                            Swal.fire({
                                icon: 'success',
                                title: 'Submitted!',
                                text: data.message || 'Leave application submitted successfully.',
                            }).then(() => {
                                location.reload(); // Reload after confirmation
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: data.message || 'Something went wrong while submitting.',
                            });
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        Swal.fire({
                            icon: 'error',
                            title: 'Request Failed',
                            text: 'Failed to submit application. Please try again later.',
                        });
                    });
            }
        });
    });
</script>            
                        
            
