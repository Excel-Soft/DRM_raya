        const filterForm = document.querySelector('#searchFilter').closest('form');
        if (filterForm) {
            filterForm.addEventListener('submit', function(e) {
                e.preventDefault();

                // Get date values
                const startDate = document.querySelector('input[name="Ab_report_startData"]').value;
                const endDate = document.querySelector('input[name="Ab_report_endData"]').value;

                // Validate dates
                if (!startDate || !endDate) {
                    alert('Please select both start and end dates');
                    return;
                }

                // Convert to Date objects for comparison
                const start = new Date(startDate);
                const end = new Date(endDate);

                if (start > end) {
                    alert('Start date cannot be greater than end date');
                    return;
                }

                // Add custom parameter to the form or redirect
                const currentUrl = window.location.href.split('?')[0];
                window.location.href = `${currentUrl}?custom_date_range=true&start_date=${startDate}&end_date=${endDate}`;
            });
        }
    });
