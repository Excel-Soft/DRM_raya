<script>
    document.addEventListener('DOMContentLoaded', () => {
        const rows = document.querySelectorAll('tbody > tr');
        let lastOpenedRow = null;

        rows.forEach(row => {
            row.addEventListener('click', () => {
                const dropdown = row.nextElementSibling;

                if (dropdown && dropdown.classList.contains('dropdown-content')) {
                    if (dropdown.style.display === 'table-row') {
                        // If the dropdown is already open, close it
                        dropdown.style.display = 'none';
                        row.classList.remove('open');
                        row.classList.remove('active');
                        lastOpenedRow = null;
                    } else {
                        // Close the last opened dropdown
                        if (lastOpenedRow && lastOpenedRow !== row) {
                            const lastDropdown = lastOpenedRow.nextElementSibling;
                            if (lastDropdown && lastDropdown.classList.contains('dropdown-content')) {
                                lastDropdown.style.display = 'none';
                                lastOpenedRow.classList.remove('open');
                                lastOpenedRow.classList.remove('active');
                            }
                        }

                        // Open the current dropdown
                        dropdown.style.display = 'table-row';
                        row.classList.add('open');
                        lastOpenedRow = row;
                        row.classList.add('active');
                    }
                }
            });
        });

        // Close dropdowns when clicking outside
        document.addEventListener('click', (event) => {
            if (!event.target.closest('tbody')) {
                if (lastOpenedRow) {
                    const lastDropdown = lastOpenedRow.nextElementSibling;
                    if (lastDropdown && lastDropdown.classList.contains('dropdown-content')) {
                        lastDropdown.style.display = 'none';
                        lastOpenedRow.classList.remove('open');
                        lastOpenedRow = null;
                        lastOpenedRow.classList.remove('active');
                    }
                }
            }
        });
    });
