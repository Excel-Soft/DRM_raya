<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Get elements
        const dropdownToggle = document.querySelector('.dropdown_toggle');
        const dropdownContent = document.querySelector('.custom_dropdown_content');
        const options = document.querySelectorAll('.custom_dropdown_content .option');
        const nestedToggles = document.querySelectorAll('.nested_toggle');

        // Toggle main dropdown
        dropdownToggle.addEventListener('click', function(event) {
            event.stopPropagation();
            dropdownContent.style.display = dropdownContent.style.display === 'block' ? 'none' : 'block';
        });

        // Toggle nested dropdowns and set active class
        options.forEach(option => {
            option.addEventListener('click', function(event) {
                event.stopPropagation();
                const hasNestedDropdown = this.nextElementSibling && this.nextElementSibling.classList.contains('custom_nested_dropdown_content');

                if (!hasNestedDropdown) {
                    // If no nested dropdown, close the dropdown
                    dropdownContent.style.display = 'none';
                }

                // Remove active class from all options
                options.forEach(opt => opt.classList.remove('active'));
                // Add active class to the clicked option
                this.classList.add('active');

                // Hide all nested dropdowns
                document.querySelectorAll('.custom_nested_dropdown_content').forEach(content => {
                    content.style.display = 'none';
                });
            });
        });

        nestedToggles.forEach(toggle => {
            toggle.addEventListener('click', function(event) {
                event.stopPropagation();
                const nestedContent = this.nextElementSibling;
                document.querySelectorAll('.custom_nested_dropdown_content').forEach(content => {
                    if (content !== nestedContent) {
                        content.style.display = 'none';
                    }
                });
                nestedContent.style.display = nestedContent.style.display === 'block' ? 'none' : 'block';
            });
        });

        // Close dropdowns if clicked outside
        document.addEventListener('click', function(event) {
            if (!event.target.closest('.custom_dropdown')) {
                dropdownContent.style.display = 'none';
                document.querySelectorAll('.custom_nested_dropdown_content').forEach(content => {
                    content.style.display = 'none';
                });
            }
        });
    });
</script>
