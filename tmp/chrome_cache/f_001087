            var selectedValue = $(this).val(); // Get the selected value
            var currentUrl = window.location.href; // Get the current URL

            if (currentUrl.indexOf('timeRange=') > -1) {
                // If it exists, replace the parameter
                var newUrl = currentUrl.replace(/timeRange=[^\&]*/, 'timeRange=' + selectedValue);
            } else {
                // If it doesn't exist, append the parameter
                var separator = currentUrl.indexOf('?') > -1 ? '&' : '?';
                var newUrl = currentUrl + separator + 'timeRange=' + selectedValue;
            }

            // Redirect to the new URL
            window.location.href = newUrl;

        });
    });
</script>

