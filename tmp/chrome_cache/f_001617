            },

            ajax: function (data, callback) {
                const fromDate = $('#fromDate').val();
                const toDate = $('#toDate').val();
                const userId = $('#user_idfilter').val();
                const roleId = $('#role_idfilter').val();
                const serviceId = $('#selected_service_id').val();

                if (!fromDate || !toDate) {
                    callback({
                        draw: data.draw,
                        recordsTotal: 0,
                        recordsFiltered: 0,
                        data: []
                    });
                    return;
                }

                $('#loaderChart1').show();

                $.ajax({
                    url: "layouts/Controller/FollowupController.php",
                    method: "POST",
                    dataType: "json",
                    data: {
                        action: "getFollowUpData",
                        fromDate: fromDate,
                        toDate: toDate,
                        userId: userId,
                        roleId: roleId,
                        serviceId: serviceId,
                        draw: data.draw,
                        start: data.start,
                        length: data.length
                    },
                    success: function (response) {
                        $('#loaderChart1').hide();

                        if (response.success) {
                            callback({
                                draw: response.draw || data.draw,
                                recordsTotal: parseInt(response.recordsTotal || 0),
                                recordsFiltered: parseInt(response.recordsFiltered || 0),
                                data: response.data || []
                            });
                        } else {
                            swal("Error!", response.message || "Failed to fetch data", "error");
                            callback({
                                draw: data.draw,
                                recordsTotal: 0,
                                recordsFiltered: 0,
                                data: []
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        $('#loaderChart1').hide();
                        console.error("AJAX Error:", xhr.responseText);
                        swal("Error!", "Something went wrong: " + error, "error");

                        callback({
                            draw: data.draw,
                            recordsTotal: 0,
                            recordsFiltered: 0,
                            data: []
                        });
                    }
                });
            },

            columns: [
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1;
                    }
                },
                { data: "company_name", defaultContent: "-" },
                { data: "service_type_name", defaultContent: "-" },
                { data: "service_type", defaultContent: "-" },
                { data: "grade", defaultContent: "-" },
                { data: "purpose", defaultContent: "-" },
                { data: "method", defaultContent: "-" },
                { data: "comment", defaultContent: "-" },
                { data: "username", defaultContent: "-" },
                { data: "followup_note", defaultContent: "-" },
                { data: "next_date", defaultContent: "-" },
                { data: "created_date", defaultContent: "-" }
            ],

            drawCallback: function () {
                $(".dataTables_paginate > .pagination").addClass("pagination-rounded");
            }
        });

        $('#applyDateFilter').on('click', function (e) {
            e.preventDefault();

            const fromDate = $('#fromDate').val();
            const toDate = $('#toDate').val();
            const userId = $('#user_idfilter').val();

            if (!userId || userId === "0") {
                swal("Warning!", "User ID is missing — please refresh or log in again!", "warning");
                return;
            }

            if (!fromDate || !toDate) {
                swal("Warning!", "Please select From and To date to see the data!", "warning");
                return;
            }

            if (fromDate > toDate) {
                swal("Warning!", "From date cannot be greater than To date!", "warning");
                return;
            }

            $('#selected_service_id').val('');
            resetServiceButtonColors();
            $('#serviceTypeSummary').html('');
            $('#serviceTypeSummaryWrap').hide();

            table.ajax.reload(null, true);
            loadServiceCountsByDate();
        });

        $(document).on('click', '.serviceFilterBtn', function () {
            const fromDate = $('#fromDate').val();
            const toDate = $('#toDate').val();
            const serviceId = $(this).data('service');

            if (!fromDate || !toDate) {
                swal("Warning!", "Please select From and To date first!", "warning");
                return;
            }

            $('#selected_service_id').val(serviceId);
            setActiveServiceButton(serviceId);

            table.ajax.reload(null, true);
            loadServiceTypeSummary();
        });
    });
</script>






