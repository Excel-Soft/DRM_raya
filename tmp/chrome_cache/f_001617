<script>
    $(document).ready(function () {
        const serviceClassMap = {
            316: 'btn-success',
            317: 'btn-danger',
            318: 'btn-info',
            319: 'btn-dark'
        };

        function resetServiceButtonColors() {
            $('.serviceFilterBtn').each(function () {
                const serviceId = $(this).data('service');

                $(this)
                    .removeClass('btn-primary btn-success btn-danger btn-info btn-dark active-filter')
                    .addClass(serviceClassMap[serviceId] || 'btn-secondary');
            });
        }

        function setActiveServiceButton(serviceId) {
            resetServiceButtonColors();

            if (serviceId) {
                $('.serviceFilterBtn[data-service="' + serviceId + '"]')
                    .removeClass('btn-success btn-danger btn-info btn-dark')
                    .addClass('btn-primary active-filter');
            }
        }

        function loadServiceCountsByDate() {
            const fromDate = $('#fromDate').val();
            const toDate = $('#toDate').val();
            const userId = $('#user_idfilter').val();
            const roleId = $('#role_idfilter').val();

            if (!fromDate || !toDate || !userId) {
                return;
            }

            $.ajax({
                url: "layouts/Controller/FollowupController.php",
                type: "POST",
                dataType: "json",
                data: {
                    action: "getFollowUpServiceCounts",
                    fromDate: fromDate,
                    toDate: toDate,
                    userId: userId,
                    roleId: roleId
                },
                success: function (res) {
                    if (res.success) {
                        $('#count_membership').text(res.count_membership || 0);
                        $('#count_alibaba').text(res.count_alibaba || 0);
                        $('#count_design').text(res.count_design || 0);
                        $('#count_domain').text(res.count_domain || 0);
                    } else {
