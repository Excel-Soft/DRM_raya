        function loadServiceTypeSummary() {
            const fromDate = $('#fromDate').val();
            const toDate = $('#toDate').val();
            const userId = $('#user_idfilter').val();
            const roleId = $('#role_idfilter').val();
            const serviceId = $('#selected_service_id').val();

            if (!fromDate || !toDate || !userId || !serviceId) {
                $('#serviceTypeSummary').html('');
                $('#serviceTypeSummaryWrap').hide();
                return;
            }

            $.ajax({
                url: "layouts/Controller/FollowupController.php",
                type: "POST",
                dataType: "json",
                data: {
                    action: "getFollowUpServiceTypeCounts",
                    fromDate: fromDate,
                    toDate: toDate,
                    userId: userId,
                    roleId: roleId,
                    serviceId: serviceId
                },
                success: function (res) {
                    if (res.success) {
                        let html = '';

                        if (res.service_types && res.service_types.length > 0) {
                            $.each(res.service_types, function (index, item) {
                                html += `
                                    <span class="btn btn-outline-primary btn-sm m-1" style="pointer-events:none;">
                                        ${item.service_type} (${item.total})
                                    </span>
                                `;
                            });

                            $('#serviceTypeSummary').html(html);
                            $('#serviceTypeSummaryWrap').show();
                        } else {
                            $('#serviceTypeSummary').html('');
                            $('#serviceTypeSummaryWrap').hide();
                        }
                    } else {
                        $('#serviceTypeSummary').html('');
                        $('#serviceTypeSummaryWrap').hide();
                    }
                },
                error: function (xhr) {
                    console.log("Service Type Summary AJAX Error:", xhr.responseText);
                    $('#serviceTypeSummary').html('');
                    $('#serviceTypeSummaryWrap').hide();
                }
            });
        }

