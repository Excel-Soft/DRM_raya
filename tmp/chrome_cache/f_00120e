    function cateFillter(id) {
        var catefillter = $('#cate').val();
        var cate_status = $('#cate_status').val();
        var usersids = $('#usersids').val();
        var productratingCheck = $('#productratingCheck' + id).is(":checked");

        // Split the current category values into an array
        var catValues = catefillter.split(',');

        if (productratingCheck) {
            // Add the new category ID to the array if it's not already present
            if (!catValues.includes(id.toString())) {
                catValues.push(id);
            }
        } else {
            // Remove the category ID from the array
            var index = catValues.indexOf(id.toString());
            if (index !== -1) {
                catValues.splice(index, 1);
            }
        }

        // Join the array back into a string
        var finalCat = catValues.join(',');

        // Update the value of the #cate input field
        $('#cate').val(finalCat);

        if (finalCat === '' && cate_status === '' && usersids === '') {
            reloadShowdata();
            return;
        }
        if (cate_status == '') {
            cate_status = 'All';
        }
        if (usersids == '') {
            usersids = 'All';
        }
        if (finalCat == '') {
            finalCat = 'All';
        }
        $("#loaderCustomer").show();
        $("#showdata").css({ opacity: 0.5 });

        $.ajax({
            url: "layouts/func.php",
            cache: true,
            method: "POST",
            data: {
                finalCatSeracDesign: finalCat,
                finalCatSeracDesignStatus: cate_status,
                finalCatSeracDesignStatusByUser: usersids,
            },
            success: function (data) {
                $("#loaderCustomer").hide();
                $("#showdata").css({ opacity: 1 });
                $('#showdata').fadeIn();
                $('#showdata').html(data);
            }
        });
    }
