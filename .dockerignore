# ============================================================
# WebExcels DRM — .dockerignore
# Prevents unnecessary files from being sent to Docker context
# ============================================================

# Dependencies (will be installed fresh inside container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (rebuilt inside container)
dist

# Environment files (secrets — pass via env vars, NOT baked in)
.env
.env.*
temp_env.txt

# Git
.git
.gitignore

# IDE / Editor
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python virtualenv
venv

# Debug / temp scripts
*.sql
*.txt
*.log
*.png
diag*.ts
debug-*.ts
check-*.ts
check-*.sql
check_*.ts
fix-*.ts
fix-*.sql
test-*.ts
test-*.js
test-*.sql
verify-*.ts
verify-*.sql
verify_*.ts
inspect-*.ts
inspect_*.ts
inspect_*.js
temp-*.mjs
temp-*.cjs
temp-*.py
dump_*.ts
scan-*.ts
create-*.ts
seed-*.ts
survey.js
quick-*.js
quick-*.sql
manual-*.sql
trace-*.sql
deep-*.sql
force-*.ts
force-*.sql
move-*.ts
cleanup-*.ts
update-*.mjs
add-*.mjs

# SQL dump files
local_db_dump.sql
supabase_drm_import.sql
COMPREHENSIVE-FIX.sql
FINAL-COMPLETE-SETUP.sql
ONE-CLICK-SETUP.sql
complete-database-setup.sql
DIRECT-FIX-GM-COLUMNS.sql
FINAL-FIX-PRIVATE-POOL.sql
convert-installments-to-jsonb.sql

# Documentation (not needed in container)
*.md
!README.md
ISSUES-SUMMARY.md
DATABASE-SETUP-GUIDE.txt
WEBX_AI_ASSISTANT_GUIDE.md
design_guidelines.md

# Render config
render.yaml

# Attached assets directory (large files)
attached_assets

# Column / permission dump files
cols*.txt
columns*.txt
permissions_dump.txt
rbac_output.txt
inspection_output.txt
put-endpoint.txt
password-options.txt
db_cols.txt
table_info.txt

# Batch / helper scripts
*.bat
*.ps1
