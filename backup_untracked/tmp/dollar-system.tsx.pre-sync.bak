                                                            <td className="border-b border-r px-3 py-3">{row.pkr}</td>
                                                            <td className="border-b border-r px-3 py-3 text-center">
                                                                {row.screenshot ? <Eye className="mx-auto h-4 w-4 text-[#6d7591]" /> : null}
                                                            </td>
                                                            <td className="border-b border-r px-3 py-3">$ {row.discount}</td>
                                                            <td className="border-b border-r px-3 py-3">$ {row.extraDiscount.toFixed(2)}</td>
                                                            <td className="border-b border-r px-3 py-3">Pkr {row.extraPkrDiscount}</td>
                                                            <td className="border-b border-r px-3 py-3">
                                                                <Badge
                                                                    className={cn(
                                                                        "border-none px-3 py-1 text-[12px] font-bold shadow-none",
                                                                        row.status === "Cash Received" && "bg-[#d4f5e5] text-[#35c38f]",
                                                                        row.status === "Online Paid" && "bg-[#ffe8c7] text-[#f0a028]",
                                                                        row.status === "Customer Paid" && "bg-[#dbe3f5] text-[#7b86a8]"
                                                                    )}
                                                                >
                                                                    {row.status}
                                                                </Badge>
                                                            </td>
                                                            <td className="border-b border-r px-3 py-3">{row.createDate}</td>
                                                            <td className="border-b border-r px-3 py-3">{row.accountant}</td>
                                                            <td className="border-b border-r px-3 py-3">{row.hod}</td>
                                                            <td className="border-b border-r px-3 py-3">
                                                                <Badge className="border-none bg-[#fff1d7] px-3 py-1 text-[12px] font-bold text-[#f0a028] shadow-none">{row.alibaba}</Badge>
                                                            </td>
                                                            <td className="border-b border-r px-3 py-3">
                                                                <Badge className="border-none bg-[#dbe3f5] px-3 py-1 text-[12px] font-bold text-[#7b86a8] shadow-none">{row.payDate}</Badge>
                                                            </td>
                                                        </tr>
                                                    ))}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        )}


                        {/* 4. PENDING Section */}
                        <div id="pending" className="scroll-mt-24 space-y-6 relative -ml-[350px] w-[calc(100vw-48px)] bg-[#f4f6f9] py-8 px-6">
                            <div className="space-y-6 max-w-full">
                                <div className="flex flex-wrap items-center gap-x-12 gap-y-4">
                                    <h2 className="text-[22px] font-[1000] text-rose-500 uppercase tracking-tighter">Pending Approvals <span className="text-gray-900 ml-1">3</span></h2>
                                    <div className="flex flex-wrap gap-4 items-center">
                                        <div className="flex items-center gap-1.5 font-[1000] uppercase text-[11px] border-r border-gray-300 pr-4"><span>Cash Received</span><Badge className="bg-emerald-50 text-emerald-600 border-none px-2 shadow-none font-[1000]">$ 37981</Badge><Badge className="bg-rose-50 text-red-500 border-none px-2 shadow-none font-[1000]">Pkr 7027962</Badge></div>
                                        <div className="flex items-center gap-1.5 font-[1000] uppercase text-[11px] border-r border-gray-300 pr-4"><span>Online Paid</span><Badge className="bg-emerald-50 text-emerald-600 border-none px-2 shadow-none font-[1000]">$ 7913</Badge><Badge className="bg-rose-50 text-red-500 border-none px-2 shadow-none font-[1000]">Pkr 1657436</Badge></div>
                                        <div className="flex items-center gap-1.5 font-[1000] uppercase text-[11px]"><span>Customer Paid</span><Badge className="bg-emerald-50 text-emerald-600 border-none px-2 shadow-none font-[1000]">$ 4457</Badge><Badge className="bg-rose-50 text-red-500 border-none px-2 shadow-none font-[1000]">Pkr 1149893</Badge></div>
                                    </div>
                                </div>
                            </div>
                            <div className="border border-gray-200 rounded-sm overflow-hidden shadow-sm bg-white">
                                <div className="overflow-x-auto overflow-y-auto max-h-[700px] custom-scrollbar">
                                    <table className="w-full text-left text-[11px] whitespace-nowrap min-w-[1500px] border-separate border-spacing-0">
                                        <thead className="bg-[#f8f9fa] sticky top-0 z-10 border-b text-gray-800 font-black h-10 uppercase tracking-tighter shadow-sm">
                                            <tr><th className="px-3 border-r border-b">#</th><th className="px-3 border-r border-b">Drm id</th><th className="px-3 border-r border-b">Company</th><th className="px-3 border-r border-b">Sale Person</th><th className="px-3 border-r border-b">Dollar</th><th className="px-3 border-r border-b">Pkr</th><th className="px-3 border-r border-b">Dollar Rate</th><th className="px-3 border-r border-b">Ab Disc</th><th className="px-3 border-r border-b">Extra Disc</th><th className="px-3 border-r border-b">Package</th><th className="px-3 border-r border-b">Type</th><th className="px-3 border-r border-b">Droupout</th><th className="px-3 border-r border-b">Status</th><th className="px-3 border-r border-b">Accountant</th><th className="px-3 border-b">HOD</th></tr>
                                        </thead>
                                        <tbody>
                                            {[...Array(10)].map((_, i) => (<tr key={i} className="border-b last:border-0 hover:bg-rose-50/10 transition-colors h-11"><td className="p-3 border-r border-b font-bold text-gray-400">{i+1}</td><td className="p-3 border-r border-b font-[1000] text-[#00a65a] italic uppercase tracking-tighter">PKAMAR210815</td><td className="p-3 border-r border-b font-black uppercase text-gray-700">STYLEQUEST APPAREL WORLDWIDE</td><td className="p-3 border-r border-b font-bold italic text-gray-400">Ali Khan</td><td className="p-3 border-r border-b font-black text-gray-900">$ 150.00</td><td className="p-3 border-r border-b font-bold">42000</td><td className="p-3 border-r border-b">280</td><td className="p-3 border-r border-b">0</td><td className="p-3 border-r border-b">0</td><td className="p-3 border-r border-b font-bold">Standard</td><td className="p-3 border-r border-b">Partial</td><td className="p-3 border-r border-b">No</td><td className="p-3 border-r border-b font-black text-rose-500 italic uppercase">Pending</td><td className="p-3 border-r border-b font-black text-emerald-600 italic">HOD Approved</td><td className="p-3 border-b font-black text-gray-400 italic">Processing...</td></tr>))}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        {/* 5. ALIBABA section */}
                        <div id="alibaba" className="scroll-mt-24 space-y-8 relative -ml-[350px] w-[calc(100vw-48px)] bg-[#f4f6f9] py-8 px-6">
                            <div className="flex items-center gap-3">
                                <h2 className="text-[22px] font-[1000] text-gray-800 tracking-tighter uppercase whitespace-nowrap">Paid Alibaba</h2>
                                <span className="w-6 h-6 flex items-center justify-center text-[28px] font-black text-green-500 pb-2">..</span>
                                <h2 className="text-[22px] font-[1000] text-[#00a65a] tracking-tighter uppercase leading-none">Partial Payments Paid To Alibaba</h2>
                            </div>

                            <div className="flex flex-wrap items-center gap-6">
                                <div className="relative w-[360px]"><Search className="absolute left-4 top-1/2 -translate-y-1/2 text-gray-300 w-5 h-5" /><Input placeholder="Search..." className="h-12 pl-12 rounded-full border-gray-200 shadow-none text-base" /></div>
                                <div className="relative"><Input placeholder="mm/dd/yyyy" className="h-12 w-56 text-sm border-gray-200" /><Calendar className="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 w-4 h-4 pointer-events-none"/></div>
                                <div className="relative"><Input placeholder="mm/dd/yyyy" className="h-12 w-56 text-sm border-gray-200" /><Calendar className="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 w-4 h-4 pointer-events-none"/></div>
                                <Button className="bg-[#6c757d] hover:bg-[#5a6268] text-white px-10 h-12 rounded-md font-bold text-sm">Clear</Button>
                            </div>

                            <div className="space-y-3">
                                <div className="flex flex-wrap gap-2">
                                    <Button className="bg-[#00a65a] hover:bg-[#008d4c] text-white px-5 h-9 rounded-md font-black text-[11px] uppercase gap-2 shadow-sm"><Download size={14}/> Export to Excel</Button>
                                    <Badge className="bg-[#dd4b39] text-white px-5 h-9 rounded-md font-black text-[11px] uppercase border-none shadow-sm">$ In Processing 0</Badge>
                                    <Badge className="bg-[#f39c12] text-white px-5 h-9 rounded-md font-black text-[11px] uppercase border-none shadow-sm">$ Extra Disc 23797.17</Badge>
                                    <Badge className="bg-[#00a65a] text-white px-5 h-9 rounded-md font-black text-[11px] uppercase border-none shadow-sm">$ Paid 46069.06</Badge>
                                </div>
                                <div className="flex flex-wrap gap-2">
                                    <Badge className="bg-[#00a65a] text-white px-5 h-9 rounded-md font-black text-[11px] uppercase border-none shadow-sm">$ Current Profit 42697.85</Badge>
                                    <Badge className="bg-[#dd4b39] text-white px-5 h-9 rounded-md font-black text-[11px] uppercase border-none shadow-sm">$ Current Loss -16.00</Badge>
                                    <Badge className="bg-[#3c8dbc] text-white px-5 h-9 rounded-md font-black text-[11px] uppercase border-none shadow-sm">$ Custom Profit 1.34</Badge>
                                    <Badge className="bg-[#dd4b39] text-white px-5 h-9 rounded-md font-black text-[11px] uppercase border-none shadow-sm">$ Custom Loss -430.73</Badge>
                                </div>
                            </div>

                            <div className="border border-gray-100 rounded-sm overflow-hidden shadow-2xl bg-white">
                                <div ref={alibabaTableRef} className="overflow-x-auto overflow-y-auto max-h-[600px] custom-scrollbar">
                                    <table className="w-full text-left text-[9px] min-w-full table-fixed border-separate border-spacing-0 shadow-inner">
                                        <thead className="bg-[#f8f9fa] sticky top-0 z-10 border-b text-gray-800 font-extrabold h-11 uppercase tracking-tighter shadow-sm">
                                            <tr><th className="px-1.5 py-2 border-r border-b w-8"><Checkbox className="rounded-sm border-gray-300" /></th><th className="px-1.5 py-2 border-r border-b w-8">No</th><th className="px-1.5 py-2 border-r border-b w-[70px]">Ab Date</th><th className="px-1.5 py-2 border-r border-b w-[70px]">Bv Date</th><th className="px-1.5 py-2 border-r border-b w-[80px]">Drm Id</th><th className="px-1.5 py-2 border-r border-b w-[95px]">Ab Id</th><th className="px-1.5 py-2 border-r border-b w-[105px]">Order Id</th><th className="px-1.5 py-2 border-r border-b w-[170px]">Company</th><th className="px-1.5 py-2 border-r border-b w-[105px]">Person</th><th className="px-1.5 py-2 border-r border-b w-[72px]">T-Dollar</th><th className="px-1.5 py-2 border-r border-b w-[62px]">TD Rate</th><th className="px-1.5 py-2 border-r border-b w-[78px]">Package</th><th className="px-1.5 py-2 border-r border-b w-[64px]">Type</th><th className="px-1.5 py-2 border-r border-b w-[72px]">Ex-Disc</th><th className="px-1.5 py-2 border-r border-b w-[86px]">Pay Status</th><th className="px-1.5 py-2 border-r border-b w-[110px]">Report</th><th className="px-1.5 py-2 border-r border-b w-[72px]">Cus $ Rate</th><th className="px-1.5 py-2 border-r border-b w-[76px]">Cus $ Profit</th><th className="sticky right-[52px] z-20 bg-[#f8f9fa] px-1.5 py-2 border-r border-b text-center w-[104px]">View</th><th className="sticky right-0 z-20 bg-[#f8f9fa] px-1.5 py-2 border-b text-center w-[52px]">Action</th></tr>
                                        </thead>
                                        <tbody>
                                            {alibabaRows.map((row) => (
                                                <tr key={row.no} className="border-b last:border-0 hover:bg-emerald-50/10 transition-colors">
                                                    <td className="px-1.5 py-2 border-r border-b text-center"><Checkbox className="rounded-sm border-gray-300" /></td>
                                                    <td className="px-1.5 py-2 border-r border-b text-gray-500">{row.no}</td>
                                                    <td className="px-1.5 py-2 border-r border-b text-gray-500">{row.abDate}</td>
                                                    <td className="px-1.5 py-2 border-r border-b">
                                                        {row.bvDate === "03/23/2025" || row.bvDate === "11/26/2025" || row.bvDate === "03/12/2025" || row.bvDate === "04/15/2025" || row.bvDate === "12/01/2024" || row.bvDate === "03/18/2025"
                                                            ? <Badge className="border-none bg-[#ff7d7d] px-2 py-0.5 text-[11px] font-bold text-white shadow-none">{row.bvDate}</Badge>
                                                            : row.bvDate}
                                                    </td>
                                                    <td className="px-1.5 py-2 border-r border-b font-[1000] text-[#00a65a] italic uppercase tracking-tighter">{row.drmId}</td>
                                                    <td className="px-1.5 py-2 border-r border-b font-bold text-[#00a65a]">{row.abId}</td>
                                                    <td className="px-1.5 py-2 border-r border-b text-[#00a65a]">{row.orderId}</td>
                                                    <td className="px-1.5 py-2 border-r border-b font-[1000] text-gray-800 break-words">{row.company}</td>
                                                    <td className="px-1.5 py-2 border-r border-b text-gray-700 break-words">{row.person}</td>
                                                    <td className="px-1.5 py-2 border-r border-b font-[1000] text-gray-900">$ {row.tDollar.toFixed(2)}</td>
                                                    <td className="px-1.5 py-2 border-r border-b">{row.tdRate}</td>
                                                    <td className="px-1.5 py-2 border-r border-b">{row.package}</td>
                                                    <td className="px-1.5 py-2 border-r border-b">{row.type}</td>
                                                    <td className="px-1.5 py-2 border-r border-b">{row.exDisc}</td>
                                                    <td className="px-1.5 py-2 border-r border-b">
                                                        <Badge className="border-none bg-[#d4f5e5] px-1.5 py-0.5 text-[10px] font-bold text-[#35c38f] shadow-none">{row.payStatus}</Badge>
                                                    </td>
                                                    <td className="px-1.5 py-2 border-r border-b">
                                                        <Badge className={cn(
                                                            "border-none px-1.5 py-0.5 text-[10px] font-bold shadow-none",
                                                            row.report.startsWith("Profit") && "bg-[#d4f5e5] text-[#35c38f]",
                                                            row.report.startsWith("Loss") && "bg-[#ffdede] text-[#ff6b6b]",
                                                            row.report.startsWith("Equal") && "bg-[#fff1d7] text-[#f0a028]"
                                                        )}>
                                                            {row.report}
                                                        </Badge>
                                                    </td>
                                                    <td className="px-1.5 py-2 border-r border-b">{row.cusRate.toFixed(2)}</td>
                                                    <td className="px-1.5 py-2 border-r border-b">{row.cusProfit.toFixed(2)}</td>
                                                    <td className="sticky right-[52px] z-10 bg-white px-1.5 py-2 border-r border-b text-center w-[104px]">
                                                        <Button className="h-7 rounded-full bg-[#00a65a] px-2.5 text-[10px] font-bold text-white hover:bg-[#008d4c]">View</Button>
                                                    </td>
                                                    <td className="sticky right-0 z-10 bg-white px-1.5 py-2 border-b text-center w-[52px]">
                                                        <div className="mx-auto flex h-6 w-6 items-center justify-center rounded-full bg-[#f3b544] text-white">
                                                            <Eye size={11} />
                                                        </div>
                                                    </td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>

            <style jsx>{`
                .no-scrollbar::-webkit-scrollbar { display: none; }
                .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
                .custom-scrollbar::-webkit-scrollbar { height: 6px; width: 6px; }
                .custom-scrollbar::-webkit-scrollbar-track { background: #f1f1f1; }
                .custom-scrollbar::-webkit-scrollbar-thumb { background: #00a65a; border-radius: 10px; }
            `}</style>
        </div>
    );
}
