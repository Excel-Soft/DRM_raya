    const parsePartialDate = (value: string) => {
        const parts = value.split("/");
        if (parts.length !== 3) return null;
        const [day, month, year] = parts;
        if (!day || !month || !year) return null;
        return new Date(Number(year), Number(month) - 1, Number(day));
    };

    const partialRowsByDate = partialRows.filter((row) => {
        const rowDateParts = row.createDate.split("-");
        const rowDate = new Date(Number(rowDateParts[2]), Number(rowDateParts[1]) - 1, Number(rowDateParts[0]));
        const from = partialAppliedFromDate ? parsePartialDate(partialAppliedFromDate) : null;
        const to = partialAppliedToDate ? parsePartialDate(partialAppliedToDate) : null;
        if (from && rowDate < from) return false;
        if (to && rowDate > to) return false;
        return true;
    });

