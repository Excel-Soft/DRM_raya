# WebExcels DRM Copilot V1 — environment template.
# PROPOSED NEW SETTINGS. This file alone does not activate anything — copy
# the lines you need into backend/.env (which is gitignored) and set real
# values there. NEVER put a real API key in a VITE_ variable or commit it.
#
# This template does not activate the pre-existing WebX-AI assistant either;
# that integration has been retired (POST /api/ai/chat now returns 410) in
# favour of this Copilot. See docs/copilot/ACTIVATION.md for the full
# step-by-step rollout.

COPILOT_ENABLED=false
COPILOT_PROVIDER=anthropic
# Required once enabled. Do not assume a "latest" id — set the exact model
# id your Anthropic account has access to.
COPILOT_MODEL=
# Required once enabled. Server-side secret only.
DRM_COPILOT_ANTHROPIC_API_KEY=

# Empty = nobody can use Copilot (deny-all until this is populated).
# Comma-separated real drm.users UUIDs, e.g.:
# COPILOT_ALLOWED_USER_IDS=11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222
COPILOT_ALLOWED_USER_IDS=

# The one optional write (create a follow-up assigned to the confirming
# user). Keep false until the confirmed-proposal flow has been reviewed.
COPILOT_ALLOW_FOLLOWUP_CREATE=false

# Engineering defaults — not business policy. Safe to leave as-is for pilot.
COPILOT_MAX_TOOL_ROUNDS=6
COPILOT_MAX_OUTPUT_TOKENS=1500
COPILOT_MAX_TOTAL_TOKENS_PER_TURN=20000
COPILOT_REQUEST_TIMEOUT_MS=60000
COPILOT_RATE_LIMIT_PER_MINUTE=10
COPILOT_MAX_ACTIVE_TURNS_PER_CONVERSATION=1
COPILOT_MAX_TOOL_RESULT_CHARACTERS=12000
COPILOT_MAX_MESSAGE_CHARACTERS=8000
COPILOT_CONVERSATION_RETENTION_DAYS=30

# Uses the app's existing DATABASE_URL / JWT_SECRET — do not duplicate them
# here. Copilot refuses to activate (not boot the whole server) if
# MOCK_AUTH=true outside automated tests, or if JWT_SECRET is the known dev
# default / under 32 characters.
