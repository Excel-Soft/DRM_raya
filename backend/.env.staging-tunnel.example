# =============================================================================
# LOCAL USE ONLY — copy to e.g. backend/.env.local (or swap when testing staging)
# Do NOT deploy this file to the VPS or commit real passwords to Git.
#
# 1) Start SSH tunnel (on your machine):
#    ssh -N -L 55432:127.0.0.1:5432 YOUR_USER@YOUR_VPS_HOST
# 2) Fill DRM_APP_PASSWORD below (see docs in repo: postgres-installation-report.md §6)
# 3) Point your local backend at this file (copy/rename as you prefer)
# =============================================================================

# drm_legacy_stage via tunnel — no sslmode=require (SSL off for 127.0.0.1)
#
# IMPORTANT (Mac): database name MUST be drm_legacy_stage (migrated users/customers).
# Do NOT use drm_postgres (almost empty on VPS) or Supabase URL for migration testing.
DATABASE_URL=postgresql://drm_app:DRM_APP_PASSWORD_YAHAN_LIKHO@127.0.0.1:55432/drm_legacy_stage
DATABASE_SSL=false

# Mac tunnel user drm_app may not own tables; skip runtime DDL on drm_legacy_stage
SKIP_SCHEMA_ENSURE=true

# Copy from your normal local/live .env if you need the app to boot the same way:
NODE_ENV=development
JWT_SECRET=JWT_SECRET_YAHAN_LIKHO
DEBUG_SALES_DASH=true
DEBUG_AUTH=true
MOCK_AUTH=false
MOCK_AUTH_EMAIL=shahzaib@excelstech.com

PORT=5001
# Usually not needed for tunnel; was for remote Supabase TLS quirks
# NODE_TLS_REJECT_UNAUTHORIZED=0
